rules_version = '2';

// KartRadar Firestore kuralları
// - Kampanya verisini sadece scraper yazar (Admin SDK kuralları atlar).
// - Uygulama kampanyaları sadece okur (anonim giriş yeterli).
// - users/{uid}: giriş yapan kullanıcının kart listesi. Herkes SADECE kendi belgesine erişir.
// - Okuma için giriş şartı: herkese açık olursa botlar okuma kotanı tüketebilir.
// - adminRuns, meta/notifyState: sadece admin panel (isAdmin).
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin panel: sadece bu Google hesabı (e-postası doğrulanmış)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'smh.dgsn@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /programCampaigns/{programId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Kampanya özeti: uygulama sadece detay açılınca okur
    match /campaignDetails/{campaignId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /meta/programIndex {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Bildirim adımının kaydı: sadece admin görür
    match /meta/notifyState {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Tarama / bildirim raporları (scraper yazar): sadece admin panel okur
    match /adminRuns/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Kullanıcının kartları: { programs: ["bonus", "axess"], updatedAt }
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['programs', 'updatedAt'])
        && request.resource.data.programs is list
        && request.resource.data.programs.size() <= 30;
    }

    // Tanımlanmamış her şey kapalı
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
